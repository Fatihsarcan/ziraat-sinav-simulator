# Soru uretimi icin Anthropic API anahtari (opsiyonel).
# Yoksa uygulama mevcut soru bankasiyla calismaya devam eder; uretim devre disi kalir.
ANTHROPIC_API_KEY=

# Uretimde kullanilacak model (varsayilan: claude-opus-5)
ZSS_GENERATION_MODEL=claude-opus-5

# Veritabani dosyasinin yeri (varsayilan: ./data/ziraat.db)
ZSS_DB_PATH=
